{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "unicorn", "react", "import", "jsx-a11y", "vitest"],
  "jsPlugins": ["oxlint-tailwindcss", "@shadcn/lint"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "settings": {
    "tailwindcss": {
      "entryPoint": "src/app/index.css",
      "rootFontSize": 16
    }
  },
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "eslint/no-unused-expressions": [
      "error",
      {
        "allowShortCircuit": true,
        "allowTernary": true
      }
    ],
    "eslint/no-irregular-whitespace": [
      "error",
      {
        "skipStrings": true,
        "skipComments": true
      }
    ],
    "eslint/eqeqeq": ["error", "smart"],
    "eslint/one-var": ["error", "never"],
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_ts"]
      }
    ],
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-call": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "error",
      {
        "allowConstantExport": true
      }
    ],
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/no-dark-without-light": "error",
    "tailwindcss/no-contradicting-variants": "error",
    "tailwindcss/enforce-canonical": "error",
    "tailwindcss/prefer-scale-token": "error",
    "tailwindcss/enforce-sort-order": "error",
    "tailwindcss/enforce-shorthand": "error",
    "tailwindcss/enforce-consistent-important-position": "error",
    "tailwindcss/enforce-negative-arbitrary-values": "error",
    "tailwindcss/enforce-consistent-variable-syntax": "error",
    "tailwindcss/consistent-variant-order": "error",
    "tailwindcss/no-hardcoded-colors": "error",
    "tailwindcss/no-unnecessary-arbitrary-value": "error",
    "tailwindcss/no-restricted-classes": [
      "error",
      {
        "patterns": [
          {
            "pattern": "(^|:)leading-\\[(?:1|1\\.25|1\\.375|1\\.5|1\\.625|2)\\]$",
            "message": "Use the matching named leading-* utility (for example, leading-tight) instead of an arbitrary value."
          }
        ]
      }
    ],
    "tailwindcss/prefer-theme-tokens": "error",
    "react/forbid-elements": [
      "error",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use Button from \"@/shared/ui/button\" instead."
          },
          {
            "element": "input",
            "message": "Use Input from \"@/shared/ui/input\" instead."
          },
          {
            "element": "textarea",
            "message": "Use Textarea from \"@/shared/ui/textarea\" instead."
          },
          {
            "element": "select",
            "message": "Use NativeSelect from \"@/shared/ui/native-select\" instead."
          },
          {
            "element": "option",
            "message": "Use NativeSelectOption from \"@/shared/ui/native-select\" instead."
          },
          {
            "element": "optgroup",
            "message": "Use NativeSelectOptGroup from \"@/shared/ui/native-select\" instead."
          },
          {
            "element": "label",
            "message": "Use Label from \"@/shared/ui/label\" instead."
          },
          {
            "element": "fieldset",
            "message": "Use FieldSet from \"@/shared/ui/field\" instead."
          },
          {
            "element": "legend",
            "message": "Use FieldLegend from \"@/shared/ui/field\" instead."
          },
          {
            "element": "table",
            "message": "Use Table from \"@/shared/ui/table\" instead."
          },
          {
            "element": "thead",
            "message": "Use TableHeader from \"@/shared/ui/table\" instead."
          },
          {
            "element": "tbody",
            "message": "Use TableBody from \"@/shared/ui/table\" instead."
          },
          {
            "element": "tfoot",
            "message": "Use TableFooter from \"@/shared/ui/table\" instead."
          },
          {
            "element": "tr",
            "message": "Use TableRow from \"@/shared/ui/table\" instead."
          },
          {
            "element": "th",
            "message": "Use TableHead from \"@/shared/ui/table\" instead."
          },
          {
            "element": "td",
            "message": "Use TableCell from \"@/shared/ui/table\" instead."
          },
          {
            "element": "caption",
            "message": "Use TableCaption from \"@/shared/ui/table\" instead."
          },
          {
            "element": "hr",
            "message": "Use Separator from \"@/shared/ui/separator\" instead."
          },
          {
            "element": "progress",
            "message": "Use Progress from \"@/shared/ui/progress\" instead."
          }
        ]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": [
          "layout",
          "panel-link",
          "preview-link",
          "dashboard-metric",
          "dashboard-start",
          "nav-backdrop",
          "nav-close",
          "topbar-menu",
          "topbar-search",
          "theme-toggle",
          "spotlight-start",
          "spotlight-adjust",
          "week-current",
          "training-day",
          "is-today",
          "exercise-preview-row",
          "recent-workout",
          "progress-highlight",
          "ai-dashboard-link"
        ]
      }
    ],
    "shadcn/no-raw-colors": [
      "error",
      {
        "allow": ["fill-none"]
      }
    ],
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": ["plain", "metric-name", "metric-bar", "metric-value", "chk", "icn", "toaster"]
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "typescript/prefer-nullish-coalescing": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/effect/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "overrides": [
    {
      "files": ["src/shared/ui/button.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["src/shared/ui/field.tsx"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["src/shared/ui/label.tsx"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      "files": [
        "src/shared/ui/textarea.tsx",
        "src/shared/ui/native-select.tsx",
        "src/shared/ui/label.tsx",
        "src/shared/ui/field.tsx",
        "src/shared/ui/table.tsx"
      ],
      "rules": {
        "react/forbid-elements": "off"
      }
    },
    {
      "files": ["src/shared/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/require-static-classes": "off"
      }
    }
  ],
  "extends": [
    "../.oxlintrc.json",
    "../node_modules/@aranlucas/oxforge/configs/react.json",
    "../node_modules/@aranlucas/oxforge/configs/vitest.json"
  ]
}
