{
  "name": "set-and-signal-web",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm instructions:generate && portless run --name set-and-signal vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:strict",
    "lint:strict": "oxlint src test --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity error && pnpm lint:policy",
    "format": "oxfmt --config oxfmt.config.ts --check .",
    "format:write": "oxfmt --config oxfmt.config.ts --write .",
    "catalog:validate": "pnpm instructions:generate && node --experimental-strip-types scripts/validate-exercise-catalog.mjs",
    "instructions:generate": "node --experimental-strip-types scripts/build-instructions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "pnpm instructions:generate && i18next-cli extract --config ./i18next.config.mjs --sync-primary --ci --dry-run && vitest run test/domain/exercises/exercise-instructions.test.ts test/i18n/i18n-catalog.test.ts test/i18n/i18n-source.test.ts test/i18n/i18n.test.ts",
    "i18n:extract": "i18next-cli extract --config ./i18next.config.mjs --sync-primary",
    "build:mobile": "pnpm instructions:generate && VITE_MOBILE=1 VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/ VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/ vite build && cap sync",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:check": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck": "pnpm instructions:generate && tsc -b && pnpm convex:check",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --config oxfmt.config.ts --check",
    "lint:policy": "oxlint --config oxlint.policy.config.ts .",
    "pretest": "pnpm catalog:validate"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@hookform/resolvers": "^6.0.0",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "convex": "^1.48.0",
    "i18next": "^26.5.11",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-to-print": "^3.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "valibot": "^1.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.65",
    "i18next-cli": "^1.80.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tailwindcss": "^1.16.0",
    "oxlint-tsgolint": "^7.0.2005",
    "portless": "0.15.12",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
