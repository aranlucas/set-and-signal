{
  "name": "set-and-signal-web",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm instructions:generate && portless run --name set-and-signal vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:strict",
    "lint:strict": "oxlint src --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity error && pnpm lint:anti-slop",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "catalog:validate": "pnpm instructions:generate && node --experimental-strip-types scripts/validate-exercise-catalog.mjs",
    "instructions:generate": "node --experimental-strip-types scripts/build-instructions.mjs",
    "test": "pnpm catalog:validate && vitest run",
    "test:watch": "vitest",
    "i18n:check": "pnpm instructions:generate && i18next-cli extract --config ./i18next.config.mjs --sync-primary --ci --dry-run && vitest run src/domain/exercises/exercise-instructions.test.ts src/i18n/i18n-catalog.test.ts src/i18n/i18n-source.test.ts src/i18n/i18n.test.ts",
    "i18n:extract": "i18next-cli extract --config ./i18next.config.mjs --sync-primary",
    "build:mobile": "pnpm instructions:generate && VITE_MOBILE=1 VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/ VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/ vite build && cap sync",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:check": "tsc --noEmit -p convex/tsconfig.json",
    "typecheck": "pnpm instructions:generate && tsc -b && pnpm convex:check",
    "lint:anti-slop": "oxlint --config .oxlintrc.anti-slop.json ."
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "i18next": "^26.4.2",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.16",
    "react-to-print": "^3.3.0",
    "shadcn": "^4.21.2",
    "sonner": "^2.0.8",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.60",
    "i18next-cli": "^1.74.8",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tailwindcss": "^1.14.0",
    "oxlint-tsgolint": "^7.0.2003",
    "portless": "0.15.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
