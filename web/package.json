{
  "name": "set-and-signal-web",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm instructions:generate && vite",
    "build": "pnpm instructions:generate && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src --type-aware --type-check --deny-warnings --report-unused-disable-directives && pnpm lint:design-system",
    "lint:design-system": "oxlint --config .oxlintrc.design-system.json src --deny-warnings",
    "lint:tailwind": "oxlint --config .oxlintrc.tailwind.json src --deny-warnings",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "catalog:validate": "pnpm instructions:generate && node --experimental-strip-types scripts/validate-exercise-catalog.mjs",
    "instructions:generate": "node --experimental-strip-types scripts/build-instructions.mjs",
    "test": "pnpm catalog:validate && vitest run",
    "test:watch": "vitest",
    "i18n:check": "pnpm instructions:generate && i18next-cli extract --config ./i18next.config.mjs --sync-primary --ci --dry-run && vitest run src/domain/exercises/exercise-instructions.test.ts src/i18n/i18n-catalog.test.ts src/i18n/i18n-source.test.ts src/i18n/i18n.test.ts",
    "i18n:extract": "i18next-cli extract --config ./i18next.config.mjs --sync-primary",
    "build:mobile": "pnpm instructions:generate && VITE_MOBILE=1 VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/ VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/ vite build && cap sync"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.0",
    "i18next-resources-to-backend": "^1.2.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-resizable-panels": "^4.12.3",
    "react-to-print": "^3.3.0",
    "recharts": "3.10.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "valibot": "^1.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "i18next-cli": "^1.71.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tailwindcss": "^1.10.1",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.1"
}
