# Server
PORT=3000
DATA_DIR=/data
DB_PATH=

# Public base URL of this API (OAuth issuer + MCP resource). Defaults to ORIGIN.
# For Grok/Cursor MCP, this must be a publicly reachable https URL.
PUBLIC_URL=

# WebAuthn / passkeys (legacy; prefer OIDC below)
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME="Set & Signal"

# OIDC providers for MCP OAuth + web sign-in (configure at least one)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Admin + invites (comma-separated admin user ids)
ADMIN_UIDS=
INVITE_ONLY=0

# Session cookie lifetime in days (min 1)
SESSION_DAYS=90

# AI workout planning via OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
